# Copia este archivo como ".env" y ajusta los valores.
# ".env" está en .gitignore y NUNCA debe subirse al repositorio.
# Si la contraseña contiene espacios o el carácter #, escríbela entre comillas.
SABERIA_DB_HOST=127.0.0.1
SABERIA_DB_PORT=3306
SABERIA_DB_USER=saberia_app
SABERIA_DB_PASSWORD=cambia_esta_clave
SABERIA_DB_NAME=saberia
SABERIA_DB_CONNECT_TIMEOUT=5
